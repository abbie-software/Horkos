# PayPal (sandbox only)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENVIRONMENT=sandbox
# simulated (default): no PayPal calls. sandbox: real PayPal sandbox money.
PAYPAL_FUNDING=simulated
# Where PayPal sends the buyer afterwards. The server adds ?payment=<id>.
PAYPAL_RETURN_URL=http://localhost:3000/funding/return
PAYPAL_CANCEL_URL=http://localhost:3000/money-tracker
# Demo only: pay every seller into this one sandbox Personal account.
PAYPAL_PAYOUT_EMAIL=

# AI (Gemini)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_THINKING_LEVEL=

# Backend
DATABASE_URL=sqlite:///./horkos.db
# A long random value. Generate one: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
FRONTEND_ORIGIN=http://localhost:3000
DEMO_CONTROLS=true

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000