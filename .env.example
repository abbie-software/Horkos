# PayPal (sandbox only)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENVIRONMENT=sandbox
# simulated (default): no PayPal calls. sandbox: real PayPal sandbox money.
PAYPAL_FUNDING=simulated
# Where PayPal sends the buyer afterwards. The server adds ?payment=<id>.
PAYPAL_RETURN_URL=http://localhost:3000/funding/return
PAYPAL_CANCEL_URL=http://localhost:3000/money-tracker
# Demo only: pay every seller into this one sandbox Personal account.
PAYPAL_PAYOUT_EMAIL=
# Optional: a real sandbox email per demo seller, so each is paid into its own account.
# Format: sel_nova=email,sel_kip=email,sel_zed=email,sel_quick=email (leave PAYPAL_PAYOUT_EMAIL empty)
SELLER_PAYPAL_EMAILS=

# AI
GEMINI_API_KEY=
GEMINI_MODEL=

# Backend
DATABASE_URL=sqlite:///./horkos.db
# A long random value. Generate one: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
FRONTEND_ORIGIN=http://localhost:3000
DEMO_CONTROLS=true

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000